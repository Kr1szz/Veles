# ==============================================================================
# Veles Shield — Production Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME="Veles Shield"
APP_VERSION="1.0.0"

# Cryptographic & Authentication Secrets
# Generate a secure 32+ byte secret: openssl rand -hex 32
SECRET_KEY=veles-shield-production-secret-key-must-be-rotated-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# DPDPA 2023 Column-Level AES-256/Fernet Encryption Key
# Generate a valid 32-byte urlsafe base64 key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AEGIS_ENCRYPTION_KEY=c2VjdXJlLWRwZHBhLWFlZ2lzLXRydXN0LTIwMjYtMDAwMSE=
VELES_ENCRYPTION_KEY=c2VjdXJlLWRwZHBhLWFlZ2lzLXRydXN0LTIwMjYtMDAwMSE=

# Database Connection URL
# Local SQLite fallback: sqlite:///./veles_shield.db
# Production PostgreSQL: postgresql+psycopg2://veles_user:veles_secure_pass_2026@postgres:5432/veles_shield
DATABASE_URL=sqlite:///./veles_shield.db

# Redis Sliding Window Velocity & Cache
# Local daemon: redis://localhost:6379/0
# Container / Cluster: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Performance & SLA Thresholds
SLA_MAX_LATENCY_MS=50.0
RATE_LIMIT_GLOBAL_PER_MIN=120
VELOCITY_KYC_LIMIT_PER_MIN=5
VELOCITY_TX_LIMIT_PER_MIN=10

# Risk Engine Thresholds
RISK_THRESHOLD_AUTO_APPROVE=0.30
RISK_THRESHOLD_MANUAL_REVIEW=0.70
SHANNON_ENTROPY_HIGH_THRESHOLD=4.2
SHANNON_ENTROPY_LOW_THRESHOLD=1.2
EWMA_ALPHA=0.20

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
