# AEGIS-Trust Environment Configuration Template

# Runtime Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME=AEGIS-Trust
APP_VERSION=1.0.0

# Cryptographic Keys (Change in production!)
# 32-byte string for JWT signing
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# DPDPA 2023 Column Encryption Key (32-byte urlsafe base64 string)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AEGIS_ENCRYPTION_KEY=c2VjdXJlLWRwZHBhLWFlZ2lzLXRydXN0LTIwMjYtMDAwMSE=

# Database Connection
# SQLite default for local testing: sqlite:///./aegis_trust.db
# PostgreSQL for production/Docker: postgresql+psycopg2://user:password@localhost:5432/aegis_trust
DATABASE_URL=sqlite:///./aegis_trust.db

# Redis Connection
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Sub-50ms SLA and Risk Thresholds
SLA_MAX_LATENCY_MS=50.0
VELOCITY_KYC_LIMIT_PER_MIN=5
VELOCITY_TX_LIMIT_PER_MIN=10
RISK_THRESHOLD_AUTO_APPROVE=0.30
RISK_THRESHOLD_MANUAL_REVIEW=0.70
EWMA_ALPHA=0.20
