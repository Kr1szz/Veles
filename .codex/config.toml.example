# Project-local Codex MCP configuration template.
# Keep credentials in the process environment, never in this file or in version control.
[mcp_servers.stitch]
url = "https://stitch.googleapis.com/mcp"
enabled = true
startup_timeout_sec = 20
tool_timeout_sec = 60

# Header name mapped to environment variable name containing the secret
[mcp_servers.stitch.env_http_headers]
X-Goog-Api-Key = "STITCH_API_KEY"
